ervous system","peripheral nervous system (pns)","sensory neuron"],"canonical_term":"peripheral nervous system","category":"NEURO_ANATOMY","definition":"The part of the nervous system outside the brain and spinal cord that carries sensory and motor information.","display_term":"Peripheral Nervous System (PNS)","part_of_speech":"noun phrase","pronunciation_text":"Peripheral Nervous System (PNS)","source_days":[3],"source_term_id":"learning:neuroscience-90:term:e6c47bcd2537ec774060a518"},{"aliases":["axon","signal transmission","synapse","synaptic terminal"],"canonical_term":"synapse","category":"NEURO_FUNCTION","definition":"A small gap where one neuron communicates with another cell.","display_term":"Synapse","part_of_speech":"noun","pronunciation_text":"Synapse","source_days":[1],"source_term_id":"learning:neuroscience-90:term:f208248e5969ffdb9c213257"},{"aliases":["exocytosis","plasma membrane","synaptic vesicle","vesicle fusion"],"canonical_term":"vesicle fusion","category":"NEURO_FOUNDATIONS","definition":"The merging of a vesicle membrane with the plasma membrane to release contents.","display_term":"Vesicle fusion","part_of_speech":"noun phrase","pronunciation_text":"Vesicle fusion","source_days":[7],"source_term_id":"learning:neuroscience-90:term:8351f61105d1b4fdd5cbf215"},{"aliases":["autonomic control","biological rhythms","blood pressure","homeostasis"],"canonical_term":"homeostasis","category":"NEURO_FUNCTION","definition":"The regulation of internal conditions to keep the body stable and functioning.","display_term":"Homeostasis","part_of_speech":"noun","pronunciation_text":"Homeostasis","source_days":[1],"source_term_id":"learning:neuroscience-90:term:90fa69dc64493b43e44d4405"},{"aliases":["action potential","cell membrane","ion channel","ion channels","membrane potential","resting membrane potential"],"canonical_term":"membrane potential","category":"NEURO_FUNCTION","definition":"The electrical difference across a cell membrane.","display_term":"membra