{"format":"hangman-weekly-v1","items":[{"aliases":["anion","cation","chloride ion","ion","potassium ion","sodium ion"],"canonical_term":"ion","category":"NEURO_FUNCTION","definition":"An atom or molecule with an electric charge from losing or gaining electrons.","display_term":"ion","part_of_speech":"noun","pronunciation_text":"ion","source_days":[6],"source_term_id":"learning:neuroscience-90:term:d6806158f75334002321a933"},{"aliases":["cell membrane","electrical signal","ion channel","membrane potential"],"canonical_term":"ion channel","category":"NEURO_FOUNDATIONS","definition":"A specialized membrane protein that lets specific ions cross the cell membrane.","display_term":"ion channel","part_of_speech":"noun","pronunciation_text":"ion channel","source_days":[6],"source_term_id":"learning:neuroscience-90:term:12a44a83bc639a797c625d6e"},{"aliases":["axon","demyelination","myelin","myelin sheath","myelinated axon","oligodendrocytes","schwann cells"],"canonical_term":"myelin","category":"NEURO_FOUNDATIONS","definition":"A fatty insulating material that surrounds some nerve fibers and speeds signaling.","display_term":"Myelin","part_of_speech":"noun","pronunciation_text":"Myelin","source_days":[1,2],"source_term_id":"learning:neuroscience-90:term:cd1035ba1ab96b930dd143f8"},{"aliases":["demyelinating disease","demyelination","myelin","neural communication"],"canonical_term":"demyelination","category":"NEURO_CLINICAL","definition":"The loss of myelin from axons, which slows or disrupts signal transmission.","display_term":"demyelination","part_of_speech":"noun","pronunciation_text":"demyelination","source_days":[2],"source_term_id":"learning:neuroscience-90:term:7b9a4907db148acb7ec80349"},{"aliases":["chemical gradient","electrical force","membrane potential","millivolt","resting membrane potential"],"canonical_term":"resting membrane potential","category":"NEURO_FUNCTION","definition":"The electrical charge difference across a neuron’s membrane when the cell is at rest.","display_term":"resting membrane potential","part_of_speech":"noun phrase","pronunciation_text":"resting membrane potential","source_days":[6],"source_term_id":"learning:neuroscience-90:term:ccfadefe28db1356c6d94037"},{"aliases":["action potential","information transfer","neural code","temporal pattern"],"canonical_term":"neural code","category":"NEURO_FUNCTION","definition":"The pattern or timing of neural signals that carries information.","display_term":"neural code","part_of_speech":"noun","pronunciation_text":"neural code","source_days":[2],"source_term_id":"learning:neuroscience-90:term:f7166652c0416aa5aa02a19c"},{"aliases":["action potential","ion channels","membrane potential","neural code","signal transmission","spike","synaptic terminal"],"canonical_term":"action potential","category":"NEURO_FUNCTION","definition":"A brief electrical signal used by neurons to transmit information.","display_term":"action potential","part_of_speech":"noun","pronunciation_text":"action potential","source_days":[2,7],"source_term_id":"learning:neuroscience-90:term:fefc34ae8768d860f37c694f"},{"aliases":["chemical gradient","concentration difference","electrical force","ion distribution"],"canonical_term":"chemical gradient","category":"NEURO_FOUNDATIONS","definition":"A difference in concentration that influences how ions move.","display_term":"chemical gradient","part_of_speech":"noun phrase","pronunciation_text":"chemical gradient","source_days":[6],"source_term_id":"learning:neuroscience-90:term:06e3a01fe71cc6ef57ac1a45"},{"aliases":["cerebral cortex","forebrain","higher abstract functions","perception"],"canonical_term":"cerebral cortex","category":"NEURO_ANATOMY","definition":"The outer layer of the forebrain that supports conscious perception and higher functions.","display_term":"Cerebral Cortex","part_of_speech":"noun","pronunciation_text":"Cerebral Cortex","source_days":[1],"source_term_id":"learning:neuroscience-90:term:36b29d21265829304a9d8eba"},{"aliases":["brai